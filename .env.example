# Independent Yargi + Mevzuat MCP configuration
# Copy to .env and fill only the services you want to enable.

# HTTP security (stdio mode does not use this token)
REQUIRE_HTTP_AUTH=true
MCP_API_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Optional discovery APIs. The corresponding module is disabled when blank.
BRAVE_API_TOKEN=
TAVILY_API_KEY=

# Semantic search through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_DIMENSION=2048
EMBEDDING_PROMPT_STYLE=raw

# Shared process-wide Bedesten limiter (court + legislation + health check)
BEDESTEN_RATE_CAPACITY=1
BEDESTEN_RATE_REFILL_S=6.5
BEDESTEN_RATE_MAX_WAIT_S=65.0

# UYAP Emsal limiter
EMSAL_RATE_CAPACITY=1
EMSAL_RATE_REFILL_S=3.5
EMSAL_RATE_MAX_WAIT_S=8.0

# Legacy mevzuat.gov.tr Playwright path is disabled by default; Bedesten is used.
MEVZUAT_ENABLE_LEGACY_PLAYWRIGHT=false

# Optional OCR enhancement for PDF-only legislation. Requires installation
# with the "ocr" extra; otherwise MarkItDown remains the fallback.
MISTRAL_API_KEY=
