<?xml version="1.0" encoding="UTF-8"?>
<!-- UNVALIDATED ON PHYSICAL MAC

  İSTEĞE BAĞLI: ColleX'in PostgreSQL kümesini launchd açık tutar.
  PostgreSQL'i Homebrew services zaten yönetiyorsa bu dosyayı KULLANMAYIN;
  ikisi aynı kümeyi birlikte açmaya çalışır.

  postgres doğrudan (ön planda) çalışır; pg_ctl kullanılmaz, çünkü launchd
  sürecin kendisini izler. Yalnız 127.0.0.1:55432 dinlenir.

  Kurulum:
    1. Yer tutucuları değiştirin:
         __COLLEX_PGBIN__   PostgreSQL araçları, ör. Homebrew postgresql@18 bin
         __COLLEX_PGDATA__  küme klasörü (initdb ile oluşturulmuş)
         __USER_HOME__      kullanıcının ev klasörü
    2. mkdir -p ~/Library/Logs/ColleX
    3. cp com.collex.postgres.plist ~/Library/LaunchAgents/
    4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.collex.postgres.plist
  com.collex.app.plist içinde COLLEX_PGDATA da verilirse başlatıcı, portu
  dinleyen kümenin bu küme olduğunu denetler.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.collex.postgres</string>
  <key>ProgramArguments</key>
  <array>
    <string>__COLLEX_PGBIN__/postgres</string>
    <string>-D</string>
    <string>__COLLEX_PGDATA__</string>
    <string>-p</string>
    <string>55432</string>
    <string>-c</string>
    <string>listen_addresses=127.0.0.1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/ColleX/collex-postgres.out.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/ColleX/collex-postgres.log</string>
</dict>
</plist>
