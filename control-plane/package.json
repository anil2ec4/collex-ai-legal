{
  "name": "@collex/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ColleX research control-plane: capability registry, retrieval helpers, evidence verification, bounded research orchestration, and the v1 HTTP API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
